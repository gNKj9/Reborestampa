# ============================================================
#  Reborestampa — variáveis de ambiente (modelo)
#  cp .env.example .env  e preenche os segredos antes de arrancar.
# ============================================================

NODE_ENV=development

# ---------- PostgreSQL ----------
POSTGRES_USER=reborestampa
POSTGRES_PASSWORD=muda-esta-password
POSTGRES_DB=reborestampa
# Em local (fora do Docker) a base está em localhost; no docker-compose
# o serviço backend recebe o URL com host "db" (ver docker-compose.yml).
DATABASE_URL=postgresql://reborestampa:muda-esta-password@localhost:5432/reborestampa?schema=public

# ---------- API ----------
PORT=4000
# Lista separada por vírgulas. Sem wildcards: cada origem é explícita.
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=1
LOG_LEVEL=info

# ---------- JWT ----------
# Gerar com: openssl rand -base64 48
JWT_ACCESS_SECRET=troca-por-um-segredo-aleatorio-de-64-caracteres-no-minimo-000
JWT_REFRESH_SECRET=troca-por-outro-segredo-aleatorio-de-64-caracteres-no-minimo
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
JWT_ISSUER=reborestampa-api
JWT_AUDIENCE=reborestampa-web

# ---------- Cookies ----------
# Em produção: true (HTTPS obrigatório). Deixar vazio para usar o host atual.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ---------- Modo single-origin (PaaS) ----------
# true = o Express serve o build estático do frontend no mesmo domínio.
# Usado pela imagem de deploy (deploy/Dockerfile); fica false em desenvolvimento.
SERVE_STATIC=false
STATIC_DIR=./web

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ---------- Seed do administrador (usado só por `npm run db:seed`) ----------
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@reborestampa.pt
SEED_ADMIN_PASSWORD=

# ---------- Notificação de contactos (opcional) ----------
# Sem chave configurada, os pedidos ficam só na caixa de entrada do painel.
# Criar em https://resend.com (plano gratuito). A chave nunca vai para o Git.
RESEND_API_KEY=
CONTACT_NOTIFY_TO=reborestampa@gmail.com
# Antes de verificares um domínio no Resend, usa onboarding@resend.dev.
CONTACT_NOTIFY_FROM=Reborestampa <onboarding@resend.dev>
PUBLIC_SITE_URL=https://reborestampa.onrender.com

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:4000/api
