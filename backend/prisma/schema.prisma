// Prisma 7 — schema de dados.
// O URL de ligação é resolvido em prisma.config.ts (CLI) e no driver adapter
// @prisma/adapter-pg (runtime). Nenhuma credencial neste ficheiro.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Papéis disponíveis para RBAC. Mantém-se pequeno e explícito:
/// ADMIN  -> gestão de utilizadores e configuração
/// EDITOR -> criação/edição de conteúdo operacional
/// VIEWER -> apenas leitura
enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @db.VarChar(120)
  email          String    @unique @db.VarChar(255)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  role           Role      @default(VIEWER)
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  refreshTokens  RefreshToken[]

  @@index([role])
  @@map("users")
}

/// Refresh tokens guardados apenas como hash SHA-256.
/// Permite rotação, revogação individual e deteção de reutilização.
model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  userAgent         String?   @map("user_agent") @db.VarChar(255)
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
